<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center" android:layout_marginEnd="18dp">

    <FrameLayout android:id="@+id/action_circle" android:layout_width="52dp"
        android:layout_height="52dp" android:background="@drawable/bg_icon_circle"
        android:clickable="true" android:focusable="true">
        <ImageView android:id="@+id/action_icon" android:layout_width="22dp"
            android:layout_height="22dp" android:layout_gravity="center"
            android:src="@drawable/ic_music" android:tint="@color/text_primary" />
    </FrameLayout>
    <TextView android:id="@+id/action_label" style="@style/ActionLabel" />
</LinearLayout>
