<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- All resolvers/media hosts are HTTPS. A plaintext base config let an HTTPS→HTTP
         redirect downgrade traffic and expose API keys in the clear. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
